# Copie este arquivo para ".env" e preencha com os dados reais.
# O arquivo .env NÃO é enviado ao GitHub (está no .gitignore).

# ---------- Allianz (allianznet.com.br) ----------
ALLIANZ_USUARIO=
ALLIANZ_SENHA=

# ---------- Configurações gerais ----------
# Quantos dias para trás buscar parcelas vencidas (padrão: 90)
DIAS_RETROATIVOS=90

# true = navegador escondido (uso diário agendado)
# false = mostra o navegador na tela (útil para acompanhar/testar)
NAVEGADOR_OCULTO=true

# Opcional: caminho de um Chrome/Chromium já instalado.
# Deixe em branco para usar o navegador instalado pelo instalar.bat.
CHROMIUM_EXECUTAVEL=
