# Copie este arquivo para ".env" e preencha com os dados reais.
# O arquivo .env NÃO é enviado ao GitHub (está no .gitignore).

# ---------- Allianz (allianznet.com.br) ----------
ALLIANZ_USUARIO=
ALLIANZ_SENHA=

# ---------- Tokio Marine (portalparceiros.tokiomarine.com.br) ----------
# O robô usa sempre a corretora 32904 - H MORAIS CORRETORA DE SEGUROS LTDA-ME
TOKIO_USUARIO=
TOKIO_SENHA=

# ---------- EZZE (portal.ezzeseguros.com.br) ----------
EZZE_USUARIO=
EZZE_SENHA=

# ---------- HDI (hdi.com.br/hdidigital) ----------
HDI_USUARIO=
HDI_SENHA=

# ---------- Yelum / Aliro (novomeuespacocorretor.yelumseguros.com.br) ----------
YELUM_USUARIO=
YELUM_SENHA=

# ---------- MAPFRE (negocios.mapfre.com.br) ----------
MAPFRE_USUARIO=
MAPFRE_SENHA=

# ---------- Suhai (i4pro.suhaiseguradora.com.br) ----------
SUHAI_USUARIO=
SUHAI_SENHA=

# ---------- Zurich (espacoparceiros.zurich.com.br) ----------
ZURICH_USUARIO=
ZURICH_SENHA=

# ---------- Bradesco (wwwn.bradescoseguros.com.br/pnegocios2) ----------
BRADESCO_USUARIO=
BRADESCO_SENHA=

# ---------- Grupo Porto (corretor.portoseguro.com.br/corretoronline) ----------
PORTO_USUARIO=
PORTO_SENHA=

# ---------- Novo Seguros (portaldocorretor.novoseguros.com.br) ----------
NOVO_USUARIO=
NOVO_SENHA=

# ---------- Youse (parcerias.youse.com.br) ----------
YOUSE_USUARIO=
YOUSE_SENHA=

# ---------- Akad (digital.akadseguros.com.br/hub) ----------
AKAD_USUARIO=
AKAD_SENHA=

# ---------- Darwin (darwinseguros.com) ----------
DARWIN_USUARIO=
DARWIN_SENHA=

# ---------- Usebens (parceiro.usebens.com.br) ----------
USEBENS_USUARIO=
USEBENS_SENHA=

# ---------- Pier (parceiro.pier.digital) ----------
PIER_USUARIO=
PIER_SENHA=

# ---------- Justos (justos.com.br) ----------
JUSTOS_USUARIO=
JUSTOS_SENHA=

# ---------- Configurações gerais ----------
# Quantos dias para trás buscar parcelas vencidas (padrão: 90)
DIAS_RETROATIVOS=90

# true = navegador escondido (uso diário agendado)
# false = mostra o navegador na tela (útil para acompanhar/testar)
NAVEGADOR_OCULTO=true

# Opcional: caminho de um Chrome/Chromium já instalado.
# Deixe em branco para usar o navegador instalado pelo instalar.bat.
CHROMIUM_EXECUTAVEL=

# ---------- Painel web ----------
# Usuário e senha para entrar no painel (obrigatório definir a senha)
PAINEL_USUARIO=morais
PAINEL_SENHA=
# Porta do painel: acesse http://<ip-do-computador>:8050
PAINEL_PORTA=8050
